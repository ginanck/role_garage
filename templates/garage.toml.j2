# Garage Configuration File
# Generated by Ansible - role_garage
# Documentation: https://garagehq.deuxfleurs.fr/documentation/reference-manual/configuration/

# Basic storage configuration
metadata_dir = "{{ garage_metadata_dir }}"
data_dir = "{{ garage_data_dir }}"
db_engine = "{{ garage_db_engine }}"

# Replication configuration
replication_factor = {{ garage_replication_factor }}

# Network configuration
rpc_bind_addr = "{{ garage_rpc_bind_addr }}"
rpc_public_addr = "{{ garage_rpc_public_addr }}"
rpc_secret = "{{ garage_rpc_secret_generated }}"

{% if garage_features.metrics_enabled %}
# Metrics configuration
[admin]
api_bind_addr = "{{ garage_admin_api.api_bind_addr }}"
admin_token = "{{ garage_admin_token_generated }}"
metrics_token = "{{ garage_metrics_token_generated }}"
{% endif %}

# S3 API configuration
[s3_api]
s3_region = "{{ garage_s3_api.s3_region }}"
api_bind_addr = "{{ garage_s3_api.api_bind_addr }}"
root_domain = "{{ garage_s3_api.root_domain }}"

{% if garage_features.website_enabled %}
# S3 Web interface configuration
[s3_web]
bind_addr = "{{ garage_s3_web.bind_addr }}"
root_domain = "{{ garage_s3_web.root_domain }}"
index = "{{ garage_s3_web.index }}"
{% endif %}

{% if garage_features.k2v_enabled %}
# K2V API configuration (Key-Value store)
[k2v_api]
api_bind_addr = "{{ garage_k2v_api.api_bind_addr }}"
{% endif %}

{% if garage_cluster_mode == "cluster" and garage_cluster_nodes | length > 0 %}
# Cluster configuration for multi-node setup
{% for node in garage_cluster_nodes %}
# Node: {{ node.name | default(node.address) }}
{% endfor %}
{% endif %}

{% if garage_custom_config %}
# Custom configuration overrides
{% for key, value in garage_custom_config.items() %}
{% if value is mapping %}
[{{ key }}]
{% for subkey, subvalue in value.items() %}
{{ subkey }} = {% if subvalue is string %}"{{ subvalue }}"{% else %}{{ subvalue }}{% endif %}
{% endfor %}
{% else %}
{{ key }} = {% if value is string %}"{{ value }}"{% else %}{{ value }}{% endif %}
{% endif %}
{% endfor %}
{% endif %}
